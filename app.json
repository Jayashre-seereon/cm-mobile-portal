{
  "expo": {
    "name": "CareerMap",
    "slug": "careermap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "careermap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.global.careermap",
      "associatedDomains": [
        "applinks:thecareermap.in",
        "applinks:www.thecareermap.in",
        "applinks:careermap-user-portal.vercel.app",
        "applinks:cm-user-portal.vercel.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tez",
          "gpay",
          "phonepe",
          "paytmmp",
          "bhim",
          "credpay",
          "mobikwik",
          "amazonpay",
          "upi"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.global.careermap",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "thecareermap.in", "pathPrefix": "/reset-password" },
            { "scheme": "https", "host": "www.thecareermap.in", "pathPrefix": "/reset-password" },
            { "scheme": "https", "host": "careermap-user-portal.vercel.app", "pathPrefix": "/reset-password" },
            { "scheme": "https", "host": "cm-user-portal.vercel.app", "pathPrefix": "/reset-password" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "611c8673-213f-4a60-b705-4d6eff917b75"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/611c8673-213f-4a60-b705-4d6eff917b75"
    },
    "owner": "jayashree-0926"
  }
}
